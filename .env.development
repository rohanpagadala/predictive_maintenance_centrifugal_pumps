# Development defaults. Committed -- no secrets, safe for every developer
# to share. Loaded automatically when PDM_ENV=development (the default).

PDM_LOG_LEVEL=DEBUG

# No API key required locally -- iterate against /docs without friction.
PDM_API_KEY_REQUIRED=false

# Permissive CORS: the dashboard may run on any local port during development.
PDM_ALLOWED_ORIGINS=*

# Generous rate limits -- they exist here mainly so the limiter code path
# gets exercised locally, not to actually constrain a developer.
PDM_RATE_LIMIT_PREDICT=1000/minute
PDM_RATE_LIMIT_DEFAULT=2000/minute
