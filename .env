# Local override layer, loaded ON TOP of .env.<PDM_ENV> (see app/config.py).
# Deliberately minimal: only settings that don't vary by environment belong
# here. Environment-specific values (log level, CORS, rate limits, API key
# requirement) live in .env.development / .env.testing / .env.production
# instead, so they don't get silently clobbered by this file for every
# environment. No secrets here -- see .env.production for where a real
# PDM_API_KEY would go (not committed with a real value).
#
# NOTE: PDM_ENV itself cannot be set in any .env file -- app/config.py must
# know which .env.<environment> to load before it loads any dotenv file, so
# PDM_ENV only takes effect as a real OS/shell/container environment
# variable (`PDM_ENV=production uvicorn ...`, or docker-compose's
# `environment:` block). It defaults to "development" if unset.

PDM_HOST=0.0.0.0
PDM_PORT=8000

# Used by the dashboard to reach the API. In docker-compose this is
# overridden to http://api:8000 (container DNS name); this default is for
# running both processes directly on the host.
PDM_API_URL=http://localhost:8000

# Host-side port mapping for docker-compose (container ports stay 8000/8501).
PDM_API_PORT=8000
PDM_DASHBOARD_PORT=8501
