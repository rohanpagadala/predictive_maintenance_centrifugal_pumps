# Environment variables for local runs and docker-compose.
# No secrets here -- this project has none (no external API keys, no DB).
# Safe to commit; if that ever changes, move real secrets to .env.local and
# add it to .gitignore instead of editing this file.

PDM_LOG_LEVEL=INFO
PDM_HOST=0.0.0.0
PDM_PORT=8000

# Used by the dashboard to reach the API. In docker-compose this is
# overridden to http://api:8000 (container DNS name); this default is for
# running both processes directly on the host.
PDM_API_URL=http://localhost:8000

# Host-side port mapping for docker-compose (container ports stay 8000/8501).
PDM_API_PORT=8000
PDM_DASHBOARD_PORT=8501
