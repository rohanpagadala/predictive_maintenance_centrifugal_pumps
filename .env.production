# Production defaults (PDM_ENV=production). Committed -- but note PDM_API_KEY
# is deliberately NOT set here. Production secrets belong in the deployment
# platform's own secret store (Render/Azure/EC2/Cloud Run env vars, a
# Kubernetes Secret, etc.), injected at runtime -- never in a file that's
# checked into git, even a "production defaults" file like this one.
#
# app/config.py raises at startup if PDM_API_KEY_REQUIRED=true and no key is
# present -- that's intentional: failing fast beats silently serving
# production traffic with authentication accidentally disabled.

PDM_LOG_LEVEL=WARNING

PDM_API_KEY_REQUIRED=true
# PDM_API_KEY=              # set via the deployment platform's secret store, not here

# Set to the real dashboard/API origin(s) before deploying, comma-separated
# if there's more than one (e.g. a staging and a production frontend).
PDM_ALLOWED_ORIGINS=https://your-dashboard-domain.example.com

PDM_RATE_LIMIT_PREDICT=20/minute
PDM_RATE_LIMIT_DEFAULT=120/minute
