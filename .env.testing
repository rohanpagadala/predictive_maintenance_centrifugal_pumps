# Testing defaults -- used by CI and local `pytest` runs (PDM_ENV=testing).
# Committed -- no secrets.

PDM_LOG_LEVEL=INFO

# No API key required so the test suite can hit every endpoint directly.
PDM_API_KEY_REQUIRED=false

PDM_ALLOWED_ORIGINS=*

# High enough that the test suite's rapid-fire requests never trip the
# limiter and turn a functional test into a flaky rate-limit test.
PDM_RATE_LIMIT_PREDICT=10000/minute
PDM_RATE_LIMIT_DEFAULT=10000/minute
